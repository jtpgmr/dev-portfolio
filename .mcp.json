{
  "mcpServers": {
    "sanity-io": {
      "type": "http",
      "url": "https://mcp.sanity.io"
    },
    "vercel": {
      "type": "http",
      "url": "https://mcp.vercel.com"
    },
    "next-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "next-devtools-mcp@latest"
      ]
    },
    "agno-docs": {
      "type": "http",
      "url": "https://docs.agno.com/mcp"
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ]
    },
    "github-reader": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/readonly",
      "oauth": {
        "clientId": "${GITHUB_APP_CLIENT_ID}",
        "callbackPort": 33418
      }
    }
  }
}